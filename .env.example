# Copia questo file in ".env" e compila i valori.

# Stringa casuale lunga (es. generata con: openssl rand -hex 32)
SESSION_SECRET=

# Percorsi sul QNAP
ARCHIVIO_NAS=/share/Lavori
DATI_NAS=/share/Container/studio-tecnico

# Porta esposta sul NAS
PORTA=3000

# Utente e gruppo del NAS che possiedono i file (comando "id nomeutente" via SSH)
PUID=1000
PGID=100

# Metti true quando il sito è servito in HTTPS (consigliato/obbligatorio su Internet)
COOKIE_SECURE=false
# Metti true se l'app è dietro il reverse proxy del QNAP o un altro proxy
TRUST_PROXY=false

# Dimensione massima per file caricato (MB)
MAX_UPLOAD_MB=200

# Assistente AI per scrivere email e messaggi WhatsApp (facoltativo).
# Crea una chiave su https://platform.claude.com → API keys. Senza chiave l'app funziona lo stesso,
# ma i messaggi vanno scritti a mano.
ANTHROPIC_API_KEY=
# Modello usato (lascia vuoto per il predefinito)
AI_MODELLO=
