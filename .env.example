# Copia questo file in ".env" e compila i valori.

# Stringa casuale lunga (es. generata con: openssl rand -hex 32)
SESSION_SECRET=

# Percorsi sul QNAP
ARCHIVIO_NAS=/share/Lavori
DATI_NAS=/share/Container/studio-tecnico

# Porta esposta sul NAS
PORTA=3000

# Utente e gruppo del NAS che possiedono i file (comando "id nomeutente" via SSH)
PUID=1000
PGID=100

# Metti true quando il sito è servito in HTTPS (consigliato/obbligatorio su Internet)
COOKIE_SECURE=false
# Metti true se l'app è dietro il reverse proxy del QNAP o un altro proxy
TRUST_PROXY=false

# Metti true se l'app è raggiungibile da un sottodominio (es. area.geometrainnocenti.it)
# e il sito dello studio è altrove: l'indirizzo apre subito la pagina di accesso
SOLO_AREA=false

# Dimensione massima per file caricato (MB)
MAX_UPLOAD_MB=200

# Indirizzo pubblico dell'area clienti, usato nei link delle email
URL_PUBBLICO=https://area.geometrainnocenti.it

# Invio email (password dimenticata ed email di benvenuto) dalla casella dello studio.
# I dati SMTP li trovi nel pannello del provider della casella (es. Aruba: smtps.aruba.it, porta 465).
# Lascia SMTP_HOST vuoto per disattivare le email.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@geometrainnocenti.it
SMTP_PASS=
MAIL_FROM=info@geometrainnocenti.it

# Casella amministrazione (notule e proforma). Stesso server SMTP, credenziali della casella amministrazione@.
SMTP_AMM_USER=
SMTP_AMM_PASS=
MAIL_AMM_FROM=amministrazione@geometrainnocenti.it

# Chiusura automatica della sessione dopo questi minuti senza attività (predefinito 30)
INATTIVITA_MINUTI=30
# Antivirus per i file in arrivo dalle imprese (scripts/attiva-antivirus.sh lo imposta da solo)
CLAMAV_HOST=
# Lettura delle risposte delle imprese ai promemoria (casella info@ via IMAP).
# Con la posta Aruba non serve altro: usa imaps.aruba.it e le stesse credenziali di SMTP_USER/SMTP_PASS.
# LEGGI_RISPOSTE=false per spegnerla.
IMAP_HOST=
LEGGI_RISPOSTE=true
