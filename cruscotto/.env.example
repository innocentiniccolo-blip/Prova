# Copia questo file in ".env" (nella stessa cartella) e compila i valori.

# ---------- Assistente AI (facoltativo) ----------
# Basta UNA delle due chiavi. Senza chiave il cruscotto funziona lo stesso (i messaggi si scrivono a mano).
# Google Gemini (piano gratuito disponibile): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Anthropic Claude (a pagamento): https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# Se ci sono entrambe le chiavi, quale usare: gemini oppure claude (vuoto = claude)
AI_FORNITORE=
# Modello Gemini (vuoto = gemini-3.8-flash)
GEMINI_MODELLO=

# Porta su cui si apre il cruscotto: http://localhost:3100
PORTA=3100

# Cartella dove salvare l'archivio (vuoto = cartella "dati" qui accanto).
# Esempio per salvarlo su OneDrive o su una chiavetta: DATI_DIR=D:\Backup\cruscotto
DATI_DIR=

# ---------- Posta (facoltativo) ----------
# Casella da leggere: il cruscotto legge la posta in arrivo, la abbina alle pratiche
# e prepara le bozze di risposta. Le mail NON vengono segnate come lette.
EMAIL_INDIRIZZO=
# Password della casella (la stessa che usi in Thunderbird / webmail Aruba)
EMAIL_PASSWORD=
# Nome del mittente nelle risposte (vuoto = nome dello studio)
EMAIL_NOME=
# Ogni quanti minuti controllare la posta
EMAIL_CONTROLLO_MINUTI=5
# Al primo collegamento legge le mail degli ultimi N giorni
EMAIL_GIORNI_INIZIALI=14
# Bozze automatiche: clienti (solo mail di clienti in rubrica o legate a una pratica), tutte, no
EMAIL_BOZZE_AUTOMATICHE=clienti
# Server: già impostati per Aruba, cambiali solo se usi un altro gestore
IMAP_HOST=imaps.aruba.it
IMAP_PORTA=993
SMTP_HOST=smtps.aruba.it
SMTP_PORTA=465

# ---------- Google Drive ----------
# Cartella dello studio dentro Google Drive per desktop. Vuoto = la cerco da sola
# (es. G:\Il mio Drive\Studio Innocenti). Compila solo se non viene trovata.
DRIVE_DIR=
DRIVE_CARTELLA=Studio Innocenti

# ---------- WhatsApp ----------
# Cartella (dentro quella dello studio) dove salvi le chat esportate dal telefono
WHATSAPP_CARTELLA=_WhatsApp da importare
# Il tuo nome come appare nelle chat esportate (vuoto = lo riconosco da solo)
WHATSAPP_MIO_NOME=
WHATSAPP_CONTROLLO_MINUTI=10
