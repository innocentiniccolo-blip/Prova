# Copia questo file in ".env" (nella stessa cartella) e compila i valori.

# Chiave per l'assistente AI che scrive email e messaggi WhatsApp (facoltativa).
# Si crea su https://platform.claude.com → API keys. Senza chiave il cruscotto funziona lo stesso.
ANTHROPIC_API_KEY=

# Porta su cui si apre il cruscotto: http://localhost:3100
PORTA=3100

# Cartella dove salvare l'archivio (vuoto = cartella "dati" qui accanto).
# Esempio per salvarlo su OneDrive o su una chiavetta: DATI_DIR=D:\Backup\cruscotto
DATI_DIR=

# ---------- Posta (facoltativo) ----------
# Casella da leggere: il cruscotto legge la posta in arrivo, la abbina alle pratiche
# e prepara le bozze di risposta. Le mail NON vengono segnate come lette.
EMAIL_INDIRIZZO=
# Password della casella (la stessa che usi in Thunderbird / webmail Aruba)
EMAIL_PASSWORD=
# Nome del mittente nelle risposte (vuoto = nome dello studio)
EMAIL_NOME=
# Ogni quanti minuti controllare la posta
EMAIL_CONTROLLO_MINUTI=5
# Al primo collegamento legge le mail degli ultimi N giorni
EMAIL_GIORNI_INIZIALI=14
# Bozze automatiche: clienti (solo mail di clienti in rubrica o legate a una pratica), tutte, no
EMAIL_BOZZE_AUTOMATICHE=clienti
# Server: già impostati per Aruba, cambiali solo se usi un altro gestore
IMAP_HOST=imaps.aruba.it
IMAP_PORTA=993
SMTP_HOST=smtps.aruba.it
SMTP_PORTA=465
