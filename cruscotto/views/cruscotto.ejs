<%- include('partials/testa') %>
<section class="sezione">
  <div class="contenitore">
    <div class="barra-titolo">
      <h1>Cruscotto</h1>
      <div class="azioni">
        <a class="pulsante secondario" href="/clienti/nuovo">+ Nuovo cliente</a>
        <a class="pulsante" href="/pratiche/nuova">+ Nuova pratica</a>
      </div>
    </div>

    <div class="riepilogo">
      <a class="carta numero" href="/pratiche"><strong><%= aperte.length %></strong><span>Pratiche aperte</span></a>
      <a class="carta numero <%= nScadute ? 'allarme' : '' %>" href="#scadenze"><strong><%= nScadute %></strong><span>Scadenze superate</span></a>
      <a class="carta numero <%= nEntro15 ? 'attenzione' : '' %>" href="#scadenze"><strong><%= nEntro15 %></strong><span>Scadenze entro 15 giorni</span></a>
      <a class="carta numero" href="#attivita"><strong><%= attivita.length %></strong><span>Attività da fare</span></a>
      <div class="carta numero"><strong class="importo"><%= euro(daIncassare) %></strong><span>Da incassare</span></div>
      <div class="carta numero"><strong class="importo"><%= euro(incassatoAnno) %></strong><span>Incassato nel <%= anno %></span></div>
    </div>

    <% if (mailDaRispondere && mailDaRispondere.length) { %>
      <div class="carta" id="posta">
        <div class="barra-titolo"><h2>Mail da rispondere (<%= mailDaRispondere.length %>)</h2><a href="/posta">Apri la posta →</a></div>
        <ul class="elenco-posta compatto">
          <% mailDaRispondere.slice(0, 6).forEach(e => { %>
            <li class="<%= e.stato %>">
              <a href="/posta/<%= e.id %>" class="riga-posta">
                <span class="mittente"><strong><%= e.mittente_nome || e.mittente_email %></strong> · <%= e.oggetto || '(senza oggetto)' %></span>
                <small class="muto"><%= e.riassunto || '' %></small>
              </a>
              <span class="etichette"><% if (e.pratica_id) { %><span class="badge stato-in-istruttoria"><%= e.pratica_tipo %></span><% } %><% if (e.stato === 'bozza') { %><span class="badge stato-rilasciata-conclusa">✨ bozza pronta</span><% } %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="due-colonne cruscotto">
      <div class="carta" id="scadenze">
        <h2>Scadenze (superate e prossimi 30 giorni)</h2>
        <% if (!scadenze.length) { %><p class="vuoto">Nessuna scadenza in vista. 👍</p><% } %>
        <ul class="elenco-scadenze">
          <% scadenze.forEach(s => { const u = urgenza(s.data); %>
            <li class="<%= u.classe %>">
              <form method="post" action="/pratiche/<%= s.pratica_id %>/scadenze/<%= s.id %>/segna" class="spunta">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="fatta" value="1">
                <input type="hidden" name="torna" value="/#scadenze">
                <button class="casella" title="Segna come fatta" aria-label="Segna come fatta"></button>
              </form>
              <div>
                <strong><%= s.descrizione %></strong>
                <small><a href="/pratiche/<%= s.pratica_id %>"><%= s.tipo %><%= s.ente ? ' – ' + s.ente : '' %></a><% if (s.cliente_nome || s.commessa) { %> · <%= [s.commessa, s.cliente_nome].filter(Boolean).join(' ') %><% } %></small>
              </div>
              <span class="quando"><%= data(s.data) %><br><small><%= u.testo %></small></span>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="carta" id="attivita">
        <h2>Attività da fare</h2>
        <% if (!attivita.length) { %><p class="vuoto">Nessuna attività in sospeso.</p><% } %>
        <ul class="elenco-scadenze">
          <% attivita.forEach(a => { %>
            <li>
              <form method="post" action="/pratiche/<%= a.pratica_id %>/attivita/<%= a.id %>/segna" class="spunta">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="fatta" value="1">
                <input type="hidden" name="torna" value="/#attivita">
                <button class="casella" title="Segna come fatta" aria-label="Segna come fatta"></button>
              </form>
              <div>
                <strong><%= a.testo %></strong>
                <small><a href="/pratiche/<%= a.pratica_id %>"><%= a.tipo %><%= a.ente ? ' – ' + a.ente : '' %></a><% if (a.cliente_nome || a.commessa) { %> · <%= [a.commessa, a.cliente_nome].filter(Boolean).join(' ') %><% } %></small>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>

    <div class="carta">
      <div class="barra-titolo"><h2>Pratiche aperte</h2><a href="/pratiche">Tutte le pratiche →</a></div>
      <% if (!aperte.length) { %>
        <p class="vuoto">Nessuna pratica aperta. <a href="/pratiche/nuova">Apri la prima pratica</a>.</p>
      <% } else { %>
        <input type="search" class="filtro" placeholder="Cerca per tipo, Comune, cliente, commessa, protocollo…" data-filtro="#tabella-aperte tbody tr">
        <%- include('partials/tabella-pratiche', { pratiche: aperte, idTabella: 'tabella-aperte' }) %>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/piede') %>
