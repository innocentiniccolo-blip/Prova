<%- include('partials/testa') %>
<section class="sezione">
  <div class="contenitore medio">
    <a class="indietro" href="<%= pratica.id ? `/pratiche/${pratica.id}` : (pratica.cliente_id ? `/clienti/${pratica.cliente_id}` : '/') %>">← Indietro</a>
    <h1><%= titolo %></h1>
    <% if (errore) { %><div class="avviso errore"><%= errore %></div><% } %>
    <form method="post" action="<%= pratica.id ? `/pratiche/${pratica.id}` : '/pratiche' %>" class="modulo carta">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Cliente
        <select name="cliente_id" data-scelta-cliente>
          <option value="">— nessuno / cliente nuovo —</option>
          <% clienti.forEach(c => { %><option value="<%= c.id %>" <%= Number(pratica.cliente_id) === c.id ? 'selected' : '' %>><%= c.nome %></option><% }) %>
        </select>
      </label>
      <fieldset data-cliente-nuovo <%= pratica.cliente_id ? 'hidden' : '' %>>
        <legend>Cliente nuovo <small class="muto">(facoltativo: lo aggiungo alla rubrica)</small></legend>
        <div class="riga-campi">
          <label>Nome e cognome <input name="nuovo_cliente_nome" maxlength="200" value="<%= pratica.nuovo_cliente_nome || '' %>"></label>
          <label>Cellulare <input name="nuovo_cliente_telefono" inputmode="tel" maxlength="50" value="<%= pratica.nuovo_cliente_telefono || '' %>"></label>
          <label>Email <input type="email" name="nuovo_cliente_email" maxlength="200" value="<%= pratica.nuovo_cliente_email || '' %>"></label>
        </div>
      </fieldset>
      <div class="riga-campi">
        <label class="stretto-campo">Commessa <input name="commessa" maxlength="40" value="<%= pratica.commessa || '' %>" placeholder="Es. 2026-014"></label>
        <label>Indirizzo dell'immobile <input name="indirizzo" maxlength="300" value="<%= pratica.indirizzo || '' %>" placeholder="Es. Via Roma 12, Montevarchi"></label>
      </div>
      <div class="riga-campi">
        <label>Tipo di pratica
          <input name="tipo" list="tipi-pratica" value="<%= pratica.tipo || '' %>" required maxlength="120" placeholder="Es. SCIA, DOCFA, APE…">
        </label>
        <label>Comune / ente
          <input name="ente" list="enti" value="<%= pratica.ente || '' %>" maxlength="200" placeholder="Es. Comune di Montevarchi">
        </label>
      </div>
      <datalist id="tipi-pratica"><% studio.pratiche.tipi.forEach(t => { %><option value="<%= t %>"><% }) %></datalist>
      <datalist id="enti"><% studio.pratiche.enti.forEach(e => { %><option value="<%= e %>"><% }) %></datalist>
      <label>Oggetto <small>cosa riguarda la pratica</small>
        <textarea name="oggetto" rows="2" maxlength="2000" placeholder="Es. Frazionamento unità immobiliare e diversa distribuzione interna"><%= pratica.oggetto || '' %></textarea>
      </label>
      <div class="riga-campi">
        <label>Stato
          <select name="stato">
            <% studio.pratiche.stati.forEach(s => { %><option <%= s === pratica.stato ? 'selected' : '' %>><%= s %></option><% }) %>
          </select>
        </label>
        <label>N. protocollo <input name="protocollo" value="<%= pratica.protocollo || '' %>" maxlength="80"></label>
        <label>Data protocollo <input type="date" name="data_protocollo" value="<%= pratica.data_protocollo || '' %>"></label>
        <label>N. pratica dell'ente <input name="numero_pratica" value="<%= pratica.numero_pratica || '' %>" maxlength="80" placeholder="Es. SCIA 145/2026"></label>
      </div>
      <label class="stretto-campo">Onorario concordato (€)
        <input name="onorario" inputmode="decimal" value="<%= pratica.onorario || '' %>" placeholder="Es. 1.500,00">
        <small>Gli acconti e i saldi si registrano dalla scheda della pratica.</small>
      </label>
      <label>Note interne <textarea name="note" rows="4" maxlength="5000"><%= pratica.note || '' %></textarea></label>
            <button class="pulsante"><%= pratica.id ? 'Salva' : 'Crea pratica' %></button>
    </form>
  </div>
</section>
<%- include('partials/piede') %>
