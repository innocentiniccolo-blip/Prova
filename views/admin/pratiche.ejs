<%- include('../partials/testa') %>
<section class="sezione">
  <div class="contenitore">
    <div class="barra-titolo">
      <h1>Pratiche</h1>
      <a class="pulsante" href="/studio/pratiche/nuova">+ Nuova pratica</a>
    </div>
    <div class="carta">
      <% if (!pratiche.length) { %>
        <p class="vuoto">Nessuna pratica. Aprila dalla scheda di un lavoro oppure con “Nuova pratica”.</p>
      <% } else { %>
        <div class="riga-filtri">
          <input type="search" class="filtro" placeholder="Cerca per tipo, Comune, lavoro, cliente, protocollo…" data-filtro="#tabella-pratiche tbody tr">
          <select data-filtro-stato="#tabella-pratiche tbody tr" aria-label="Filtra per stato">
            <option value="">Tutti gli stati</option>
            <option value="__aperte" selected>Solo aperte</option>
            <% studio.pratiche.stati.forEach(s => { %><option><%= s %></option><% }) %>
          </select>
        </div>
        <script type="application/json" id="stati-chiusi"><%- JSON.stringify(studio.pratiche.statiChiusi).replace(/</g, '\\u003c') %></script>
        <%- include('../partials/tabella-pratiche', { pratiche, idTabella: 'tabella-pratiche' }) %>
      <% } %>
    </div>
  </div>
</section>
<%- include('../partials/piede') %>
