<%- include('partials/testa') %>
<section class="sezione">
  <div class="contenitore stretto">
    <div class="carta">
      <h1>Imposta la password</h1>
      <% if (!link) { %>
        <div class="avviso errore">Il link non è più valido: è scaduto oppure è già stato usato.</div>
        <p><a href="/password-dimenticata">Richiedi un nuovo link</a> oppure contatta lo studio al <a href="tel:<%= studio.telefono.replace(/[^+\d]/g, '') %>"><%= studio.telefono %></a>.</p>
      <% } else { %>
        <p>Ciao <%= link.nome %>, scegli la password per accedere con <strong><%= link.email %></strong>.</p>
        <% if (errore) { %><div class="avviso errore"><%= errore %></div><% } %>
        <form method="post" class="modulo">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="email" name="email" value="<%= link.email %>" autocomplete="username" hidden>
          <label>Nuova password <small>almeno 10 caratteri</small>
            <input type="password" name="nuova" required minlength="10" autocomplete="new-password" autofocus></label>
          <label>Ripeti la password <input type="password" name="conferma" required minlength="10" autocomplete="new-password"></label>
          <p class="nota">Salvando confermi di aver letto l'<a href="/privacy" target="_blank" rel="noopener">informativa sulla privacy</a> dell'area clienti.</p>
          <button class="pulsante pieno">Salva la password</button>
        </form>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/piede') %>
