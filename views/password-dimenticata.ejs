<%- include('partials/testa') %>
<section class="sezione">
  <div class="contenitore stretto">
    <div class="carta">
      <h1>Password dimenticata</h1>
      <% if (inviata) { %>
        <div class="avviso ok">Se l'indirizzo è registrato, riceverai a breve un'email con il link per scegliere una nuova password. Controlla anche la cartella spam.</div>
        <p><a href="/accedi">← Torna all'accesso</a></p>
      <% } else { %>
        <p>Scrivi l'email con cui accedi: ti mandiamo un link per sceglierne una nuova.</p>
        <% if (errore) { %><div class="avviso errore"><%= errore %></div><% } %>
        <form method="post" action="/password-dimenticata" class="modulo">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Email <input type="email" name="email" required autocomplete="username" autofocus></label>
          <button class="pulsante pieno">Invia il link</button>
        </form>
        <p class="nota"><a href="/accedi">← Torna all'accesso</a></p>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/piede') %>
